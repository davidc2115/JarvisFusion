<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      minSdk reste 26 pour toute l'app (fusion Phase 4g, "RETIRE TOUT IA LOCAL DE NEWJARVIS,
      POUR GREFFER SIMPLEMENT CELLE DE JARVIS2") meme si la lib client AICore declare elle-meme
      minSdk 31. AiCoreEngine ne tourne de toute facon que sur des appareils qui ont reellement
      AICore (des appareils 31+ haut de gamme), et chaque appel est protege par try/catch via
      AiCoreSessionFactory.tryCreate — sur un appareil plus ancien, cette construction echoue
      simplement et AiEngineManager retombe sur le modele GGUF optionnel puis SmolVLM2, jamais
      de crash. Voir AiCoreEngine.kt.
    -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.aicore" />

    <!-- ── Réseau ────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- ── Audio / Micro ─────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── Téléphone ─────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- ── SMS / MMS ─────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />

    <!-- ── Contacts ──────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- ── Agenda ────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- ── Médias (Android 13+ = séparées, <13 = storage) ───────────────────── -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- ── Stockage (Android <= 12) ─────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Accès total au stockage (Android 11+) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- ── Caméra ────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ── Localisation ──────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Bluetooth ─────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- ── Notifications ─────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- ── Système ───────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Exemption d'optimisation batterie : indispensable sur beaucoup de telephones (Xiaomi/MIUI
         en tete) pour que l'ecoute permanente (WakeWordService) ne soit pas tuee par le systeme
         apres quelques minutes en arriere-plan (voir requestBatteryExemptionButton). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <!-- BUG RÉEL CORRIGÉ : sur certains ROM/OEM, com.android.deskclock.HandleSetAlarmActivity
         exige EN PLUS cette permission custom (distincte de la permission standard ci-dessus)
         pour accepter l'intent ACTION_SET_ALARM — sans elle, l'appel échouait avec
         "Permission Denial: ... requires com.android.alarm.permission.SET_ALARM" alors même
         que la permission standard était bien déclarée. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Intégration Stable Diffusion WebUI via Termux (opt-in, voir TermuxController) ──
         Permission dédiée exigée par Termux lui-même (com.termux.permission.RUN_COMMAND) pour
         qu'une app tierce puisse lui envoyer des commandes — SANS ELLE, Termux refuse
         silencieusement toute commande venant de JARVIS. Accordée par l'utilisateur via
         Réglages système Android (pas une simple pop-up runtime, Termux l'exige via la page
         "Autorisations" de l'app dans les paramètres Android), EN PLUS d'un réglage manuel
         obligatoire à faire une seule fois DANS Termux (allow-external-apps=true dans
         ~/.termux/termux.properties) que JARVIS ne peut pas modifier lui-même (sandbox
         Android : chaque app a son propre répertoire privé, JARVIS n'a pas accès à celui de
         Termux). Termux doit être installé par l'utilisateur lui-même (F-Droid recommandé,
         la version Play Store ne supporte plus RUN_COMMAND). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- targetSdkVersion >= 30 (Android 11+) : sans cette déclaration, JARVIS ne peut même
         pas VÉRIFIER si Termux est installé ni lui envoyer d'intent (restriction de visibilité
         des paquets) — l'appairage échouerait silencieusement, exactement le genre de bug
         invisible que ce projet évite systématiquement ailleurs (voir FreeboxController). -->
    <queries>
        <package android:name="com.termux" />

        <!-- Même restriction de visibilité (Android 11+) pour l'appli Horloge/Réveil par
             défaut : sans ces déclarations, intent.resolveActivity() renvoie TOUJOURS null
             même quand une vraie appli Horloge est installée, et JARVIS répond à tort
             "aucune application horloge n'est installée" (bug réel signalé par l'utilisateur,
             alors que le téléphone en a bien une) — startActivity() aurait fonctionné sans
             cette vérification, mais pas la vérification préalable elle-même. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>

        <!-- Visibilité du service de reconnaissance vocale système (Android 11+) : requis pour
             que SpeechRecognizer.createSpeechRecognizer() trouve le moteur par défaut du
             téléphone : voir WakeWordService.startKeywordSpotting() (mode-clé libre, ex:
             "Jarvis" seul ou tout autre mot personnalisé non couvert par un modèle openWakeWord
             pré-entraîné). Sans cette déclaration, le service de reconnaissance reste invisible
             et l'écoute échouerait silencieusement, comme pour Termux/Horloge ci-dessus. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Jarvis"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">

        <!-- ── Activités ─────────────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Paramètres"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VoiceModeActivity"
            android:exported="false"
            android:label="Mode vocal"
            android:theme="@style/Theme.Jarvis"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PhoneControlActivity"
            android:exported="false"
            android:label="Contrôle téléphone"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GitHubActivity"
            android:exported="false"
            android:label="GitHub"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EmailConfigActivity"
            android:exported="false"
            android:label="Configuration Email IMAP/SMTP"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ObsidianActivity"
            android:exported="false"
            android:label="🧠 Second Brain — Obsidian"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VaultGraphActivity"
            android:exported="false"
            android:label="🌌 Toile Obsidian — exploration"
            android:theme="@style/Theme.Jarvis" />

        <activity
            android:name=".SmartHomeActivity"
            android:exported="false"
            android:label="☰ Menu JARVIS"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".HomeAssistantActivity"
            android:exported="false"
            android:label="Home Assistant"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NetworkActivity"
            android:exported="false"
            android:label="Réseau local"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MusicActivity"
            android:exported="false"
            android:label="Musique"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GenerationActivity"
            android:exported="false"
            android:label="Génération IA"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Receiver SMS (Validation des permissions SMS sur Android 10+) ── -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ── Service de lecture des notifications ───────────────────────────── -->
        <service
            android:name=".JarvisNotificationListenerService"
            android:exported="true"
            android:label="JARVIS — Lecteur de notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── Service d'écoute permanente (mot-clé d'activation) ─────────────── -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ── Service de génération IA en arrière-plan (image/vidéo/site) ────── -->
        <service
            android:name=".GenerationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ── Serveur web local (hebergement d'un site JARVIS depuis le telephone) ── -->
        <service
            android:name=".LocalWebServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ── Tuiles Paramètres rapides (Wi-Fi / Bluetooth téléphone) ─────────── -->
        <service
            android:name=".JarvisWifiTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="JARVIS Wi-Fi"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".JarvisBluetoothTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="JARVIS Bluetooth"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ── Relance l'écoute permanente après redémarrage du téléphone ─────── -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── Provider de fichiers (import/export) ───────────────────────────── -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
